# HajjMed 2027 production environment template
# Copy this file to a secure secret store or deployment environment.
# Do not commit this file to version control.

NODE_ENV=production
PORT=4000

DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>?schema=public
REDIS_URL=redis://<redis_host>:6379

JWT_ACCESS_SECRET=<32+_character_random_secret>
JWT_REFRESH_SECRET=<different_32+_character_random_secret>
OTP_PEPPER=<strong_random_pepper>
OTP_DEMO_MODE=false

SMS_PROVIDER=<approved_sms_provider>
EMAIL_PROVIDER=<approved_email_provider>

OBJECT_STORAGE_ENDPOINT=https://<storage-host>
OBJECT_STORAGE_REGION=<region>
OBJECT_STORAGE_BUCKET=<bucket-name>
OBJECT_STORAGE_ACCESS_KEY=<access-key>
OBJECT_STORAGE_SECRET_KEY=<secret-key>

APP_ORIGIN=https://<production-domain>
EXPO_PUBLIC_API_URL=https://<production-api-domain>/api/v1

DEPLOYMENT_APPROVED=true
CLINICAL_APPROVAL=true
PEN_TEST_APPROVED=true
DPIA_APPROVED=true
ALLOW_PRODUCTION_MIGRATION=true
MIGRATION_BACKUP_PATH=/secure/backups/hajjmed-production.sql

# Optional operational controls
# SENTRY_DSN=
# LOG_LEVEL=info
# API_HEALTH_URL=https://<production-domain>/health/ready
