NODE_ENV=development
PORT=4000
# Supabase PostgreSQL: use the transaction/session pooler URL for runtime queries.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require&pgbouncer=true
# Supabase direct connection URL for Prisma migrations.
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
OTP_PEPPER=replace-with-a-random-server-side-pepper
OTP_DEMO_MODE=true
SMS_PROVIDER=console
EMAIL_PROVIDER=console
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=hajjmed-clinical
OBJECT_STORAGE_ACCESS_KEY=hajjmed
OBJECT_STORAGE_SECRET_KEY=replace-this-development-secret
APP_ORIGIN=http://localhost:5173
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
