generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PILGRIM
  AGENT
  CLINICIAN
  NURSE
  ALLIED_HEALTH
  ADMIN
  MEDICAL_DIRECTOR
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum IdentityStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum AppointmentPurpose {
  SCREENING
  VACCINATION
  SCREENING_AND_VACCINATION
  REVIEW
}

enum BookingCategory {
  SCHEDULED
  WALK_IN
  VIP
}

enum AppointmentStatus {
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ScreeningOutcome {
  GREEN
  AMBER
  RED
}

enum EncounterType {
  CLINIC
  ACUTE_CARE
  EMERGENCY
}

enum EncounterStatus {
  PLANNED
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum OtpChannel {
  SMS
  EMAIL
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  OTP_SENT
  OTP_VERIFIED
  OVERRIDE
  EXPORT
  BREAK_GLASS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Organization {
  id         String    @id @default(uuid())
  name       String
  type       String
  accredited Boolean   @default(false)
  users      User[]
  pilgrims   Pilgrim[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([name, type])
}

model User {
  id              String         @id @default(uuid())
  email           String?        @unique
  phoneNormalized String?        @unique
  passwordHash    String
  role            Role
  status          UserStatus     @default(PENDING)
  displayName     String
  organizationId  String?
  organization    Organization?  @relation(fields: [organizationId], references: [id])
  pilgrim         Pilgrim?
  practitioner    Practitioner?
  sessions        Session[]
  otpChallenges   OtpChallenge[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([organizationId, role])
}

model Practitioner {
  id                      String         @id @default(uuid())
  userId                  String         @unique
  user                    User           @relation(fields: [userId], references: [id])
  profession              String
  regulator               String
  licenseNumberNormalized String         @unique
  licenseExpiry           DateTime
  identityStatus          IdentityStatus @default(PENDING)
  verifiedAt              DateTime?
  verifiedByUserId        String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
}

model Pilgrim {
  id                       String             @id @default(uuid())
  userId                   String?            @unique
  user                     User?              @relation(fields: [userId], references: [id])
  passportNumberNormalized String             @unique
  passportExpiry           DateTime
  surname                  String
  givenNames               String
  dateOfBirth              DateTime
  sex                      String
  nationality              String             @default("Ghanaian")
  region                   String
  photoObjectKey           String?
  organizationId           String?
  organization             Organization?      @relation(fields: [organizationId], references: [id])
  appointments             Appointment[]
  screenings               Screening[]
  encounters               Encounter[]
  allergies                Allergy[]
  medications              Medication[]
  immunizations            Immunization[]
  documents                ClinicalDocument[]
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([organizationId])
  @@index([surname, givenNames])
}

model Facility {
  id           String        @id @default(uuid())
  name         String        @unique
  countryCode  String
  city         String
  active       Boolean       @default(true)
  appointments Appointment[]
  encounters   Encounter[]
}

model Appointment {
  id                 String             @id @default(uuid())
  reference          String             @unique
  pilgrimId          String
  pilgrim            Pilgrim            @relation(fields: [pilgrimId], references: [id])
  facilityId         String
  facility           Facility           @relation(fields: [facilityId], references: [id])
  purpose            AppointmentPurpose
  category           BookingCategory    @default(SCHEDULED)
  status             AppointmentStatus  @default(CONFIRMED)
  region             String
  startsAt           DateTime
  endsAt             DateTime
  idempotencyKey     String             @unique
  bookedByUserId     String
  screeningId        String?
  clinicalDecision   String?
  authorizedByUserId String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([pilgrimId, startsAt])
  @@index([region, startsAt, purpose, status])
}

model Screening {
  id                    String           @id @default(uuid())
  pilgrimId             String
  pilgrim               Pilgrim          @relation(fields: [pilgrimId], references: [id])
  questionnaireVersion  String
  outcome               ScreeningOutcome
  positiveFindings      Json
  rationale             String
  recommendations       String?
  performedByUserId     String
  reviewedByUserId      String?
  authenticatedByUserId String?
  authenticatedAt       DateTime?
  performedAt           DateTime         @default(now())
  ruleSetVersion        String
  supersedesId          String?
  createdAt             DateTime         @default(now())

  @@index([pilgrimId, performedAt])
  @@index([authenticatedAt])
}

model Encounter {
  id              String          @id @default(uuid())
  pilgrimId       String
  pilgrim         Pilgrim         @relation(fields: [pilgrimId], references: [id])
  facilityId      String
  facility        Facility        @relation(fields: [facilityId], references: [id])
  type            EncounterType
  status          EncounterStatus @default(IN_PROGRESS)
  chiefComplaint  String?
  diagnosisCodes  Json
  summary         String
  interventions   Json
  disposition     String?
  clinicianUserId String
  startedAt       DateTime        @default(now())
  endedAt         DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([pilgrimId, startedAt])
}

model Allergy {
  id               String   @id @default(uuid())
  pilgrimId        String
  pilgrim          Pilgrim  @relation(fields: [pilgrimId], references: [id])
  codeSystem       String
  code             String
  display          String
  reaction         String?
  severity         String?
  status           String
  recordedByUserId String
  createdAt        DateTime @default(now())
}

model Medication {
  id                 String   @id @default(uuid())
  pilgrimId          String
  pilgrim            Pilgrim  @relation(fields: [pilgrimId], references: [id])
  codeSystem         String
  code               String
  display            String
  dose               String
  route              String
  frequency          String
  status             String
  prescribedByUserId String?
  createdAt          DateTime @default(now())
}

model Immunization {
  id              String   @id @default(uuid())
  pilgrimId       String
  pilgrim         Pilgrim  @relation(fields: [pilgrimId], references: [id])
  vaccineCode     String
  vaccineDisplay  String
  lotNumber       String
  expiryDate      DateTime
  administeredAt  DateTime
  facilityId      String
  performerUserId String
  createdAt       DateTime @default(now())

  @@unique([pilgrimId, vaccineCode, administeredAt])
}

model ClinicalDocument {
  id               String    @id @default(uuid())
  pilgrimId        String
  pilgrim          Pilgrim   @relation(fields: [pilgrimId], references: [id])
  category         String
  objectKey        String    @unique
  mimeType         String
  sha256           String    @unique
  studyDate        DateTime?
  sourceFacility   String?
  interpretation   String?
  uploadedByUserId String
  createdAt        DateTime  @default(now())
}

model OtpChallenge {
  id                String     @id @default(uuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id])
  channel           OtpChannel
  destinationMasked String
  codeHash          String
  expiresAt         DateTime
  attempts          Int        @default(0)
  consumedAt        DateTime?
  createdAt         DateTime   @default(now())

  @@index([userId, createdAt])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())

  @@index([userId, expiresAt])
}

model AuditEvent {
  id           String      @id @default(uuid())
  action       AuditAction
  actorUserId  String?
  actorRole    Role?
  subjectType  String
  subjectId    String?
  patientId    String?
  reason       String?
  metadata     Json
  ipAddress    String?
  requestId    String
  occurredAt   DateTime    @default(now())
  previousHash String?
  eventHash    String      @unique

  @@index([patientId, occurredAt])
  @@index([actorUserId, occurredAt])
}

model RegionalDailyCapacity {
  id                 String   @id @default(uuid())
  region             String
  date               DateTime @db.Date
  scheduledScreening Int      @default(0)
  vaccination        Int      @default(0)
  specialScreening   Int      @default(0)
  version            Int      @default(0)

  @@unique([region, date])
}

model Notification {
  id                String             @id @default(uuid())
  appointmentId     String?
  recipientType     String
  destination       String
  channel           OtpChannel
  template          String
  payload           Json
  status            NotificationStatus @default(PENDING)
  attempts          Int                @default(0)
  providerReference String?
  sentAt            DateTime?
  createdAt         DateTime           @default(now())

  @@index([status, createdAt])
  @@index([appointmentId])
}
