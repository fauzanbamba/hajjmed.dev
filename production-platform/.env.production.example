# Production-safe template for HajjMed 2027
# Copy this file to .env.production and replace every placeholder with secret values.
# Never commit the real .env.production file to source control.

NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_DB_PASSWORD@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=replace-with-a-64-character-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-64-character-random-refresh-secret
OTP_PEPPER=replace-with-a-strong-random-otp-pepper
OTP_DEMO_MODE=false

SMS_PROVIDER=your-approved-sms-provider
EMAIL_PROVIDER=your-approved-email-provider

OBJECT_STORAGE_ENDPOINT=https://storage.example.com
OBJECT_STORAGE_REGION=eu-west-1
OBJECT_STORAGE_BUCKET=hajjmed-clinical-prod
OBJECT_STORAGE_ACCESS_KEY=replace-with-storage-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-storage-secret-key

APP_ORIGIN=https://api.example.com
EXPO_PUBLIC_API_URL=https://api.example.com/api/v1

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
MINIO_ROOT_USER=hajjmed
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password

DEPLOYMENT_APPROVED=true
CLINICAL_APPROVAL=true
PEN_TEST_APPROVED=true
DPIA_APPROVED=true
ALLOW_PRODUCTION_MIGRATION=true
